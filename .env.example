# Copiá este archivo a la raíz del repo como `.env` y completá valores.
# El proyecto usa PostgreSQL.
# Creá la base si no existe:  CREATE DATABASE "mamboDB";
# Y después, desde src/:      alembic upgrade head

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mamboDB

# URL única (SQLAlchemy / Alembic). Opcional si ya definís las variables POSTGRES_* arriba.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mamboDB
#
# En producción esto apunta a Supabase, y tiene que ser la cadena del **pooler**
# (`...pooler.supabase.com`), no la de conexión directa (`db.<ref>.supabase.co`):
# la directa resuelve solo por IPv6 y Render no tiene salida IPv6, así que falla
# con un "Network is unreachable" que no explica nada.
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Autenticación (JWT en cookie httponly) ──
# Obligatorio: sin JWT_SECRET la app no arranca. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Algoritmo de firma y duración del token (horas).
JWT_ALGORITHM=HS256
JWT_TTL_HORAS=8
# En producción (con HTTPS) poner True: la cookie deja de viajar por HTTP.
# Activarlo sin TLS deja a todos afuera del panel.
COOKIE_SECURE=False
# lax | strict | none. `lax` sirve mientras el navegador vea al front y a la API
# bajo el mismo origen, que es lo que garantiza el proxy de client/vercel.json.
# `none` solo haría falta si el front llamara al dominio de Render directo, y
# tiene un costo alto: Safari e iOS bloquean esa cookie por defecto.
# `none` exige COOKIE_SECURE=True; si no, la app no arranca.
COOKIE_SAMESITE=lax

# Dominios habilitados para CORS, separados por coma (solo producción; en dev
# ya se acepta cualquier puerto de localhost). Con el proxy de Vercel no hace
# falta ninguno: el navegador ve un solo origen y nunca hay request cross-origin.
CORS_ORIGINS=

# ── Almacenamiento de fotos ──
# local → escribe en media/ y sirve por /media. Es el modo de desarrollo.
# r2    → sube a Cloudflare R2. OBLIGATORIO en producción: el disco de Render es
#         efímero y se borra entero en cada deploy, así que una foto guardada en
#         local dura hasta la próxima subida de código.
STORAGE_BACKEND=local

# Configuración de R2. Solo se lee si STORAGE_BACKEND=r2, y en ese caso las cinco
# son obligatorias: sin ellas la app no arranca, para no aceptar fotos y
# perderlas en silencio.
#
# OJO: son DOS dominios distintos y no son intercambiables.
#
#   R2_ENDPOINT_URL     por acá se SUBE. Es la API S3: privada, cada request va
#                       firmada. Está en R2 → Overview → "S3 API".
#   R2_PUBLIC_BASE_URL  por acá se LEE. Es lo que abre el navegador y lo que se
#                       guarda en la base. Sale de habilitar el acceso público
#                       del bucket (Settings → Public Development URL), o del
#                       dominio propio que se le conecte.
#
# Poner el endpoint S3 como URL pública deja todas las fotos rotas con un 401:
# el navegador no firma nada. La app rechaza esa combinación al arrancar.
#
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=mambocloude
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
#
# Credenciales del token: R2 → Manage API Tokens → Object Read & Write,
# limitado al bucket del proyecto.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
