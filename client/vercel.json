{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://mambo-api-qpo0.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://mambo-api-qpo0.onrender.com/auth/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
